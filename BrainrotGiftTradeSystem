local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")

local INTERACT_PROMPT_NAME = "BrainrotInteractPrompt"

local GIFT_STATE_EVENT_NAME = "BrainrotGiftStateEvent"
local GIFT_ACTION_EVENT_NAME = "BrainrotGiftActionEvent"
local TRADE_STATE_EVENT_NAME = "BrainrotTradeStateEvent"
local TRADE_ACTION_EVENT_NAME = "BrainrotTradeActionEvent"

local PROMPT_MAX_DISTANCE = 10
local PROMPT_HOLD_DURATION = 0.5

local TIMEOUT_SECONDS = 15

local NotificationService = nil
pcall(function()
	local mod = ReplicatedStorage:WaitForChild("NotificationService", 5)
	if mod then
		local required = require(mod)
		if typeof(required) == "table" then
			NotificationService = required
		end
	end
end)

local function notify(player: Player?, text: string, style: string, duration: number)
	if not player or player.Parent == nil then
		return
	end
	if NotificationService and typeof(NotificationService.Notify) == "function" then
		NotificationService.Notify(player, text, style, duration)
	end
end

local raritySet: { [string]: boolean } = {
	Common = true,
	Uncommon = true,
	Rare = true,
	Epic = true,
	Legendary = true,
	Mythic = true,
	Secret = true,
	Easter = true,
}

local function ensureRemoteEvent(name: string): RemoteEvent
	local existing = ReplicatedStorage:FindFirstChild(name)
	if existing then
		if existing:IsA("RemoteEvent") then
			return existing
		end
		error("ReplicatedStorage." .. name .. " must be a RemoteEvent")
	end

	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = ReplicatedStorage
	return ev
end

local giftStateEvent = ensureRemoteEvent(GIFT_STATE_EVENT_NAME)
local giftActionEvent = ensureRemoteEvent(GIFT_ACTION_EVENT_NAME)
local tradeStateEvent = ensureRemoteEvent(TRADE_STATE_EVENT_NAME)
local tradeActionEvent = ensureRemoteEvent(TRADE_ACTION_EVENT_NAME)

local function isValidRarity(r: any): boolean
	if typeof(r) ~= "string" then
		return false
	end
	return raritySet[r] == true
end

local function getHumanoidRootPart(character: Model?): BasePart?
	if not character then
		return nil
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

local function getEquippedBrainrotTool(player: Player): Tool?
	local character = player.Character
	if not character then
		return nil
	end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			if isValidRarity(child:GetAttribute("Rarity")) then
				return child
			end
		end
	end
	return nil
end

local function buildOfferText(tool: Tool): string
	local nameAttr = tool:GetAttribute("OriginalBrainrotName")
	local levelAttr = tool:GetAttribute("BrainrotLevel")
	local mutationAttr = tool:GetAttribute("Mutation")

	local name = if typeof(nameAttr) == "string" and nameAttr ~= "" then nameAttr else nil
	local level = tonumber(levelAttr)
	if level and (level ~= level or level == math.huge or level == -math.huge) then
		level = nil
	end
	if level then
		level = math.floor(level)
		if level < 1 then
			level = 1
		end
	end

	local mutation = if typeof(mutationAttr) == "string" and mutationAttr ~= "" then mutationAttr else nil

	if name and level then
		if mutation then
			return name .. " [" .. mutation .. "] [Level " .. tostring(level) .. "]"
		end
		return name .. " [Level " .. tostring(level) .. "]"
	end

	return tool.Name
end

local function ensureInteractPromptOnCharacter(character: Model)
	local hrp = getHumanoidRootPart(character)
	if not hrp then
		return
	end

	local legacyGift = hrp:FindFirstChild("BrainrotGiftPrompt")
	if legacyGift and legacyGift:IsA("ProximityPrompt") then
		legacyGift:Destroy()
	end

	local existing = hrp:FindFirstChild(INTERACT_PROMPT_NAME)
	if existing and existing:IsA("ProximityPrompt") then
		existing.ActionText = "Interact"
		existing.ObjectText = ""
		existing.HoldDuration = PROMPT_HOLD_DURATION
		existing.MaxActivationDistance = PROMPT_MAX_DISTANCE
		existing.RequiresLineOfSight = false
		existing.Enabled = false
		return
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = INTERACT_PROMPT_NAME
	prompt.ActionText = "Interact"
	prompt.ObjectText = ""
	prompt.HoldDuration = PROMPT_HOLD_DURATION
	prompt.MaxActivationDistance = PROMPT_MAX_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = hrp
end

local function safeEquipTool(player: Player, tool: Tool)
	if not player or not player.Parent then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	pcall(function()
		humanoid:EquipTool(tool)
	end)
end

local function moveToolToBackpackAndEquip(player: Player, tool: Tool)
	if not player or not player.Parent then
		tool:Destroy()
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		backpack = player:WaitForChild("Backpack", 3)
	end
	if not backpack then
		tool:Destroy()
		return
	end
	tool.Parent = backpack
	task.wait(0.1)
	safeEquipTool(player, tool)
end

type PendingGift = {
	token: string,
	stage: string,
	giverUserId: number,
	receiverUserId: number,
	tool: Tool,
	expiresAt: number,
}

type PendingTrade = {
	token: string,
	userA: number,
	userB: number,
	toolA: Tool,
	toolB: Tool,
	acceptedA: boolean,
	acceptedB: boolean,
	expiresAt: number,
}

local pendingGiftByUserId: { [number]: PendingGift } = {}
local pendingTradeByUserId: { [number]: PendingTrade } = {}

local function clearGift(p: PendingGift)
	pendingGiftByUserId[p.giverUserId] = nil
	pendingGiftByUserId[p.receiverUserId] = nil
end

local function clearTrade(t: PendingTrade)
	pendingTradeByUserId[t.userA] = nil
	pendingTradeByUserId[t.userB] = nil
end

local function cancelGift(p: PendingGift)
	local giver = Players:GetPlayerByUserId(p.giverUserId)
	local receiver = Players:GetPlayerByUserId(p.receiverUserId)
	local tool = p.tool

	clearGift(p)

	if tool and tool.Parent == ServerStorage then
		if giver and giver.Parent then
			moveToolToBackpackAndEquip(giver, tool)
		else
			tool:Destroy()
		end
	end

	if giver and giver.Parent then
		pcall(function()
			giftStateEvent:FireClient(giver, "Close", p.token)
		end)
	end
	if receiver and receiver.Parent then
		pcall(function()
			giftStateEvent:FireClient(receiver, "Close", p.token)
		end)
	end

	if giver and giver.Parent and receiver and receiver.Parent then
		notify(giver, "Gift to " .. receiver.Name .. " canceled", "Info", 3)
		notify(receiver, "Gift from " .. giver.Name .. " canceled", "Info", 3)
	elseif giver and giver.Parent then
		notify(giver, "Gift canceled", "Info", 3)
	elseif receiver and receiver.Parent then
		notify(receiver, "Gift canceled", "Info", 3)
	end
end

local function finalizeGiftAccepted(p: PendingGift)
	local giver = Players:GetPlayerByUserId(p.giverUserId)
	local receiver = Players:GetPlayerByUserId(p.receiverUserId)
	local tool = p.tool

	local offerText = ""
	if tool then
		offerText = buildOfferText(tool)
	end

	clearGift(p)

	if not receiver or not receiver.Parent or not tool or tool.Parent ~= ServerStorage then
		if giver and giver.Parent and tool and tool.Parent == ServerStorage then
			moveToolToBackpackAndEquip(giver, tool)
		elseif tool and tool.Parent == ServerStorage then
			tool:Destroy()
		end
		if giver and giver.Parent then
			pcall(function()
				giftStateEvent:FireClient(giver, "Close", p.token)
			end)
		end
		if receiver and receiver.Parent then
			pcall(function()
				giftStateEvent:FireClient(receiver, "Close", p.token)
			end)
		end
		if giver and giver.Parent then
			notify(giver, "Gift failed", "Error", 3)
		end
		if receiver and receiver.Parent then
			notify(receiver, "Gift failed", "Error", 3)
		end
		return
	end

	local receiverBackpack = receiver:FindFirstChildOfClass("Backpack")
	if not receiverBackpack then
		receiverBackpack = receiver:WaitForChild("Backpack", 3)
	end

	if not receiverBackpack then
		if giver and giver.Parent then
			moveToolToBackpackAndEquip(giver, tool)
		else
			tool:Destroy()
		end
		notify(receiver, "Gift failed", "Error", 3)
	else
		tool.Parent = receiverBackpack
	end

	if giver and giver.Parent then
		pcall(function()
			giftStateEvent:FireClient(giver, "Close", p.token)
		end)
	end
	if receiver and receiver.Parent then
		pcall(function()
			giftStateEvent:FireClient(receiver, "Close", p.token)
		end)
	end

	if giver and giver.Parent and receiver and receiver.Parent and offerText ~= "" then
		notify(giver, "You gifted " .. offerText .. " to " .. receiver.Name, "Success", 3)
		notify(receiver, "You received " .. offerText .. " from " .. giver.Name, "Success", 3)
	elseif giver and giver.Parent then
		notify(giver, "Gift sent", "Success", 3)
	elseif receiver and receiver.Parent then
		notify(receiver, "Gift received", "Success", 3)
	end
end

local function cancelTrade(t: PendingTrade, reason: string?)
	local a = Players:GetPlayerByUserId(t.userA)
	local b = Players:GetPlayerByUserId(t.userB)

	local toolA = t.toolA
	local toolB = t.toolB

	clearTrade(t)

	if toolA and toolA.Parent == ServerStorage then
		if a and a.Parent then
			moveToolToBackpackAndEquip(a, toolA)
		else
			toolA:Destroy()
		end
	end

	if toolB and toolB.Parent == ServerStorage then
		if b and b.Parent then
			moveToolToBackpackAndEquip(b, toolB)
		else
			toolB:Destroy()
		end
	end

	if a and a.Parent then
		pcall(function()
			tradeStateEvent:FireClient(a, "Close", t.token)
		end)
	end
	if b and b.Parent then
		pcall(function()
			tradeStateEvent:FireClient(b, "Close", t.token)
		end)
	end

	local msg = "Trade canceled"
	if reason == "declined" then
		msg = "Trade declined"
	elseif reason == "timeout" then
		msg = "Trade timed out"
	end

	if a and a.Parent and b and b.Parent then
		notify(a, msg .. " with " .. b.Name, "Info", 3)
		notify(b, msg .. " with " .. a.Name, "Info", 3)
	elseif a and a.Parent then
		notify(a, msg, "Info", 3)
	elseif b and b.Parent then
		notify(b, msg, "Info", 3)
	end
end

local function finalizeTradeSwap(t: PendingTrade)
	local a = Players:GetPlayerByUserId(t.userA)
	local b = Players:GetPlayerByUserId(t.userB)

	local toolA = t.toolA
	local toolB = t.toolB

	local offerA = ""
	local offerB = ""
	if toolA then
		offerA = buildOfferText(toolA)
	end
	if toolB then
		offerB = buildOfferText(toolB)
	end

	clearTrade(t)

	if not a or not a.Parent or not b or not b.Parent or not toolA or not toolB then
		if toolA and toolA.Parent == ServerStorage then
			if a and a.Parent then
				moveToolToBackpackAndEquip(a, toolA)
			else
				toolA:Destroy()
			end
		end
		if toolB and toolB.Parent == ServerStorage then
			if b and b.Parent then
				moveToolToBackpackAndEquip(b, toolB)
			else
				toolB:Destroy()
			end
		end
		if a and a.Parent then
			pcall(function()
				tradeStateEvent:FireClient(a, "Close", t.token)
			end)
			notify(a, "Trade failed", "Error", 3)
		end
		if b and b.Parent then
			pcall(function()
				tradeStateEvent:FireClient(b, "Close", t.token)
			end)
			notify(b, "Trade failed", "Error", 3)
		end
		return
	end

	local backpackA = a:FindFirstChildOfClass("Backpack")
	if not backpackA then
		backpackA = a:WaitForChild("Backpack", 3)
	end
	local backpackB = b:FindFirstChildOfClass("Backpack")
	if not backpackB then
		backpackB = b:WaitForChild("Backpack", 3)
	end

	if not backpackA or not backpackB then
		if backpackA and toolA.Parent == ServerStorage then
			toolA.Parent = backpackA
			task.wait(0.1)
			safeEquipTool(a, toolA)
		elseif toolA.Parent == ServerStorage then
			toolA:Destroy()
		end

		if backpackB and toolB.Parent == ServerStorage then
			toolB.Parent = backpackB
			task.wait(0.1)
			safeEquipTool(b, toolB)
		elseif toolB.Parent == ServerStorage then
			toolB:Destroy()
		end

		if a and a.Parent then
			pcall(function()
				tradeStateEvent:FireClient(a, "Close", t.token)
			end)
			notify(a, "Trade failed", "Error", 3)
		end
		if b and b.Parent then
			pcall(function()
				tradeStateEvent:FireClient(b, "Close", t.token)
			end)
			notify(b, "Trade failed", "Error", 3)
		end
		return
	end

	if toolA.Parent == ServerStorage then
		toolA.Parent = backpackB
	end
	if toolB.Parent == ServerStorage then
		toolB.Parent = backpackA
	end

	task.wait(0.1)
	safeEquipTool(a, toolB)
	safeEquipTool(b, toolA)

	pcall(function()
		tradeStateEvent:FireClient(a, "Close", t.token)
	end)
	pcall(function()
		tradeStateEvent:FireClient(b, "Close", t.token)
	end)

	if a and a.Parent and b and b.Parent then
		if offerB ~= "" then
			notify(a, "Trade completed. You received " .. offerB .. " from " .. b.Name, "Success", 3)
		else
			notify(a, "Trade completed", "Success", 3)
		end
		if offerA ~= "" then
			notify(b, "Trade completed. You received " .. offerA .. " from " .. a.Name, "Success", 3)
		else
			notify(b, "Trade completed", "Success", 3)
		end
	end
end

local function openTradeForBoth(t: PendingTrade, offerA: string, offerB: string)
	local a = Players:GetPlayerByUserId(t.userA)
	local b = Players:GetPlayerByUserId(t.userB)
	if not a or not a.Parent or not b or not b.Parent then
		cancelTrade(t, "timeout")
		return
	end

	pcall(function()
		tradeStateEvent:FireClient(a, "Open", {
			token = t.token,
			youOffer = offerA,
			themOffer = offerB,
			youAccepted = t.acceptedA,
			themAccepted = t.acceptedB,
			timeoutSeconds = TIMEOUT_SECONDS,
		})
	end)

	pcall(function()
		tradeStateEvent:FireClient(b, "Open", {
			token = t.token,
			youOffer = offerB,
			themOffer = offerA,
			youAccepted = t.acceptedB,
			themAccepted = t.acceptedA,
			timeoutSeconds = TIMEOUT_SECONDS,
		})
	end)
end

local function updateTradeAcceptance(t: PendingTrade)
	local a = Players:GetPlayerByUserId(t.userA)
	local b = Players:GetPlayerByUserId(t.userB)
	if not a or not a.Parent or not b or not b.Parent then
		cancelTrade(t, "timeout")
		return
	end

	pcall(function()
		tradeStateEvent:FireClient(a, "Update", {
			token = t.token,
			youAccepted = t.acceptedA,
			themAccepted = t.acceptedB,
		})
	end)

	pcall(function()
		tradeStateEvent:FireClient(b, "Update", {
			token = t.token,
			youAccepted = t.acceptedB,
			themAccepted = t.acceptedA,
		})
	end)
end

local function startGiftFlow(giver: Player, receiver: Player, giverTool: Tool)
	if not giver or not giver.Parent or not receiver or not receiver.Parent then
		return
	end

	if pendingGiftByUserId[giver.UserId] or pendingGiftByUserId[receiver.UserId] then
		return
	end
	if pendingTradeByUserId[giver.UserId] or pendingTradeByUserId[receiver.UserId] then
		return
	end

	if giverTool.Parent ~= giver.Character then
		return
	end

	local giverHrp = getHumanoidRootPart(giver.Character)
	local receiverHrp = getHumanoidRootPart(receiver.Character)
	if not giverHrp or not receiverHrp then
		return
	end

	local dist = (giverHrp.Position - receiverHrp.Position).Magnitude
	if dist > (PROMPT_MAX_DISTANCE + 5) then
		return
	end

	giverTool.Parent = ServerStorage

	local token = HttpService:GenerateGUID(false)
	local now = os.clock()

	local pending: PendingGift = {
		token = token,
		stage = "Confirm",
		giverUserId = giver.UserId,
		receiverUserId = receiver.UserId,
		tool = giverTool,
		expiresAt = now + TIMEOUT_SECONDS,
	}

	pendingGiftByUserId[giver.UserId] = pending
	pendingGiftByUserId[receiver.UserId] = pending

	pcall(function()
		giftStateEvent:FireClient(giver, "ConfirmOpen", {
			token = token,
			targetUserId = receiver.UserId,
			targetName = receiver.Name,
			offer = buildOfferText(giverTool),
			timeoutSeconds = TIMEOUT_SECONDS,
		})
	end)

	task.delay(TIMEOUT_SECONDS, function()
		local current = pendingGiftByUserId[giver.UserId]
		if current and current.token == token and current.stage == "Confirm" then
			cancelGift(current)
		end
	end)
end

local function startTakeFlow(p: PendingGift)
	local giver = Players:GetPlayerByUserId(p.giverUserId)
	local receiver = Players:GetPlayerByUserId(p.receiverUserId)
	if not giver or not giver.Parent or not receiver or not receiver.Parent then
		cancelGift(p)
		return
	end

	if not p.tool or p.tool.Parent ~= ServerStorage then
		cancelGift(p)
		return
	end

	p.stage = "Take"

	pcall(function()
		giftStateEvent:FireClient(giver, "Close", p.token)
	end)

	pcall(function()
		giftStateEvent:FireClient(receiver, "TakeOpen", {
			token = p.token,
			giverUserId = giver.UserId,
			giverName = giver.Name,
			offer = buildOfferText(p.tool),
			timeoutSeconds = TIMEOUT_SECONDS,
		})
	end)

	task.delay(TIMEOUT_SECONDS, function()
		local current = pendingGiftByUserId[receiver.UserId]
		if current and current.token == p.token and current.stage == "Take" then
			cancelGift(current)
		end
	end)
end

local function startTradeFlow(playerA: Player, playerB: Player, toolA: Tool, toolB: Tool)
	if not playerA or not playerA.Parent or not playerB or not playerB.Parent then
		return
	end

	if pendingTradeByUserId[playerA.UserId] or pendingTradeByUserId[playerB.UserId] then
		return
	end
	if pendingGiftByUserId[playerA.UserId] or pendingGiftByUserId[playerB.UserId] then
		return
	end

	if toolA.Parent ~= playerA.Character then
		return
	end
	if toolB.Parent ~= playerB.Character then
		return
	end

	local hrpA = getHumanoidRootPart(playerA.Character)
	local hrpB = getHumanoidRootPart(playerB.Character)
	if not hrpA or not hrpB then
		return
	end

	local dist = (hrpA.Position - hrpB.Position).Magnitude
	if dist > (PROMPT_MAX_DISTANCE + 5) then
		return
	end

	toolA.Parent = ServerStorage
	toolB.Parent = ServerStorage

	local token = HttpService:GenerateGUID(false)
	local now = os.clock()

	local pending: PendingTrade = {
		token = token,
		userA = playerA.UserId,
		userB = playerB.UserId,
		toolA = toolA,
		toolB = toolB,
		acceptedA = false,
		acceptedB = false,
		expiresAt = now + TIMEOUT_SECONDS,
	}

	pendingTradeByUserId[playerA.UserId] = pending
	pendingTradeByUserId[playerB.UserId] = pending

	local offerA = buildOfferText(toolA)
	local offerB = buildOfferText(toolB)

	openTradeForBoth(pending, offerA, offerB)

	task.delay(TIMEOUT_SECONDS, function()
		local current = pendingTradeByUserId[playerA.UserId]
		if current and current.token == token then
			cancelTrade(current, "timeout")
		end
	end)
end

local function hookPlayer(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		task.defer(function()
			if character.Parent ~= nil then
				ensureInteractPromptOnCharacter(character)
			end
		end)
	end)

	if player.Character then
		task.defer(function()
			ensureInteractPromptOnCharacter(player.Character :: Model)
		end)
	end
end

local function setInteractPromptEnabled(character: Model?, enabled: boolean)
	if not character then
		return
	end
	local hrp = getHumanoidRootPart(character)
	if not hrp then
		return
	end
	local prompt = hrp:FindFirstChild(INTERACT_PROMPT_NAME)
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = enabled
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	hookPlayer(player)
	if player.Character then
		setInteractPromptEnabled(player.Character, true)
	end
end

Players.PlayerAdded:Connect(function(player: Player)
	hookPlayer(player)
	task.defer(function()
		if player.Character then
			setInteractPromptEnabled(player.Character, true)
		end
	end)
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, triggeringPlayer: Player)
	if prompt.Name ~= INTERACT_PROMPT_NAME then
		return
	end

	if not triggeringPlayer or not triggeringPlayer.Parent then
		return
	end

	local hrp = prompt.Parent
	if not hrp or not hrp:IsA("BasePart") then
		return
	end

	local targetCharacter = hrp:FindFirstAncestorOfClass("Model")
	local targetPlayer = if targetCharacter then Players:GetPlayerFromCharacter(targetCharacter) else nil
	if not targetPlayer or not targetPlayer.Parent then
		return
	end

	if targetPlayer.UserId == triggeringPlayer.UserId then
		return
	end

	local trigRebirth = triggeringPlayer:GetAttribute("Rebirth") or 0
	local targRebirth = targetPlayer:GetAttribute("Rebirth") or 0

	if trigRebirth < 5 then
		notify(triggeringPlayer, "You need Rebirth 5 or above to gift or trade.", "Error", 3)
		return
	end

	if targRebirth < 5 then
		notify(triggeringPlayer, "That player needs Rebirth 5 or above to receive gifts or trade.", "Error", 3)
		return
	end

	if pendingGiftByUserId[triggeringPlayer.UserId] or pendingTradeByUserId[triggeringPlayer.UserId] then
		return
	end
	if pendingGiftByUserId[targetPlayer.UserId] or pendingTradeByUserId[targetPlayer.UserId] then
		return
	end

	local toolA = getEquippedBrainrotTool(triggeringPlayer)
	if not toolA or toolA.Parent ~= triggeringPlayer.Character then
		notify(triggeringPlayer, "Equip a Brainrot to gift or trade", "Error", 3)
		return
	end

	local toolB = getEquippedBrainrotTool(targetPlayer)

	if toolB and toolB.Parent == targetPlayer.Character then
		startTradeFlow(triggeringPlayer, targetPlayer, toolA, toolB)
	else
		startGiftFlow(triggeringPlayer, targetPlayer, toolA)
	end
end)

giftActionEvent.OnServerEvent:Connect(function(player: Player, token: any, action: any)
	if not player or not player.Parent then
		return
	end
	if typeof(token) ~= "string" then
		return
	end
	if typeof(action) ~= "string" then
		return
	end

	local pending = pendingGiftByUserId[player.UserId]
	if not pending or pending.token ~= token then
		return
	end

	if os.clock() > pending.expiresAt then
		cancelGift(pending)
		return
	end

	if action == "ConfirmSend" then
		if player.UserId ~= pending.giverUserId then
			return
		end
		if pending.stage ~= "Confirm" then
			return
		end
		startTakeFlow(pending)
	elseif action == "ConfirmCancel" then
		if player.UserId ~= pending.giverUserId then
			return
		end
		cancelGift(pending)
	elseif action == "TakeAccept" then
		if player.UserId ~= pending.receiverUserId then
			return
		end
		if pending.stage ~= "Take" then
			return
		end
		finalizeGiftAccepted(pending)
	elseif action == "TakeCancel" then
		if player.UserId ~= pending.receiverUserId then
			return
		end
		cancelGift(pending)
	end
end)

tradeActionEvent.OnServerEvent:Connect(function(player: Player, token: any, action: any)
	if not player or not player.Parent then
		return
	end
	if typeof(token) ~= "string" then
		return
	end
	if typeof(action) ~= "string" then
		return
	end

	local pending = pendingTradeByUserId[player.UserId]
	if not pending or pending.token ~= token then
		return
	end

	if os.clock() > pending.expiresAt then
		cancelTrade(pending, "timeout")
		return
	end

	if action == "Decline" then
		cancelTrade(pending, "declined")
		return
	end

	if action ~= "Accept" then
		return
	end

	if player.UserId == pending.userA then
		pending.acceptedA = true
	elseif player.UserId == pending.userB then
		pending.acceptedB = true
	else
		return
	end

	updateTradeAcceptance(pending)

	if pending.acceptedA and pending.acceptedB then
		task.wait(0.5)
		finalizeTradeSwap(pending)
	end
end)

Players.PlayerRemoving:Connect(function(leavingPlayer: Player)
	local g = pendingGiftByUserId[leavingPlayer.UserId]
	if g then
		cancelGift(g)
	end

	local t = pendingTradeByUserId[leavingPlayer.UserId]
	if t then
		cancelTrade(t, nil)
	end
end)
