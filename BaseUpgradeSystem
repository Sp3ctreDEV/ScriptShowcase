local templatesFolder = ReplicatedStorage:WaitForChild("BaseTemplates")

local OWNER_ATTRIBUTE = "OwnerUserId"
local ASSIGNED_BASE_ATTRIBUTE = "AssignedBaseName"

local REMOTE_NAME = "BaseUpgradeEvent"
local DATASTORE_NAME = "PlayerBaseLevelV1"

local MAX_LEVEL = 3

local levelCosts: { [number]: number } = {
	[2] = 5_000_000_000,
	[3] = 2_500_000_000_000,
}

local levelMultipliers: { [number]: number } = {
	[1] = 1,
	[2] = 1.5,
	[3] = 2,
}

local store = DataStoreService:GetDataStore(DATASTORE_NAME)

