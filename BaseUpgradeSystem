local loadedLevelByUserId: { [number]: number } = {}

local moneyServiceModule = ServerScriptService:FindFirstChild("MoneyService")
local MoneyService = nil
if moneyServiceModule and moneyServiceModule:IsA("ModuleScript") then
	local ok, result = pcall(function()
		return require(moneyServiceModule)
	end)
	if ok and type(result) == "table" then
		MoneyService = result
	end
